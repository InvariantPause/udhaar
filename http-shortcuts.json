{
  "version": 4,
  "name": "Udhaar Capture",
  "shortcuts": [
    {
      "name": "Udhaar — Log Expense",
      "icon": "emoji:💸",
      "description": "Log an expense to the Udhaar Google Sheet.",
      "method": "POST",
      "url": "https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec",
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "bodyType": "custom",
      "bodyContent": "{\"token\":\"REPLACE_WITH_YOUR_SECRET\",\"action\":\"addTransaction\",\"data\":{\"type\":\"expense\",\"amount\":\"{{amount}}\",\"currency\":\"{{currency}}\",\"category\":\"{{category}}\",\"method\":\"{{method}}\",\"note\":\"{{note}}\"}}",
      "variables": [
        {
          "key": "amount",
          "label": "Amount",
          "type": "number",
          "required": true,
          "min": 1
        },
        {
          "key": "category",
          "label": "Category",
          "type": "list",
          "required": true,
          "options": [
            "Petrol / CNG",
            "Kiryana / Grocery",
            "Aata / Flour",
            "Electricity (WAPDA/K-Electric)",
            "Gas (SNGPL/SSGC)",
            "Mobile Load",
            "Internet",
            "Rent",
            "Doctor / Medicine",
            "School Fees",
            "Chai / Food",
            "Rikshaw / Careem / Bykea",
            "Salon",
            "Zakat / Charity",
            "Clothes",
            "Subscriptions",
            "Other"
          ]
        },
        {
          "key": "method",
          "label": "Payment method",
          "type": "list",
          "default": "Cash",
          "options": ["Cash", "JazzCash", "Easypaisa", "Raast", "Card", "Bank Transfer"]
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text",
          "required": false
        },
        {
          "key": "currency",
          "label": "Currency",
          "type": "list",
          "default": "PKR",
          "options": ["PKR", "USD", "INR", "EUR"]
        }
      ],
      "category": "Udhaar"
    },
    {
      "name": "Udhaar — Log Income",
      "icon": "emoji:🤑",
      "description": "Log income to the Udhaar Google Sheet.",
      "method": "POST",
      "url": "https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec",
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "bodyType": "custom",
      "bodyContent": "{\"token\":\"REPLACE_WITH_YOUR_SECRET\",\"action\":\"addTransaction\",\"data\":{\"type\":\"income\",\"amount\":\"{{amount}}\",\"currency\":\"{{currency}}\",\"category\":\"{{category}}\",\"method\":\"{{method}}\",\"note\":\"{{note}}\"}}",
      "variables": [
        { "key": "amount", "label": "Amount", "type": "number", "required": true, "min": 1 },
        {
          "key": "category",
          "label": "Category",
          "type": "list",
          "required": true,
          "options": ["Salary", "Business", "Freelance", "Remittance", "Gift (Eidi)", "Rent Received", "Refund", "Other"]
        },
        { "key": "method", "label": "Payment method", "type": "list", "default": "Bank Transfer", "options": ["Cash", "JazzCash", "Easypaisa", "Raast", "Card", "Bank Transfer"] },
        { "key": "note", "label": "Note", "type": "text", "required": false },
        { "key": "currency", "label": "Currency", "type": "list", "default": "PKR", "options": ["PKR", "USD", "INR", "EUR"] }
      ],
      "category": "Udhaar"
    },
    {
      "name": "Udhaar — Test connection",
      "icon": "emoji:✅",
      "description": "Ping the Udhaar backend to confirm the URL + token work.",
      "method": "POST",
      "url": "https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec",
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "bodyType": "custom",
      "bodyContent": "{\"token\":\"REPLACE_WITH_YOUR_SECRET\",\"action\":\"test\"}",
      "variables": [],
      "category": "Udhaar"
    }
  ]
}
